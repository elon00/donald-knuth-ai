{
  "mcpServers": {
    "donald-knuth-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "TITAN_PROTOCOL": "KNUTH",
        "TARGET_CHAIN": "Sui",
        "FIPS_203_LEVEL": "ML-KEM-768",
        "FIPS_204_LEVEL": "ML-DSA-65"
      },
      "tools": [
        {
          "name": "verify_donald_knuth_discovery",
          "description": "Verifies core invariant principles: Father of Algorithm Analysis; author of *The Art of Computer Programming*, invented TeX",
          "parameters": {
            "type": "object",
            "properties": {
              "input_data": {
                "type": "string"
              },
              "precision_level": {
                "type": "integer"
              }
            },
            "required": [
              "input_data"
            ]
          }
        },
        {
          "name": "model_donald_knuth_telemetry",
          "description": "Models high-assurance domain telemetry for Computer Science & Mathematics",
          "parameters": {
            "type": "object",
            "properties": {
              "telemetry_vector": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "telemetry_vector"
            ]
          }
        }
      ]
    }
  }
}